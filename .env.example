# ===========================================================================
# Arena OS — environment configuration
# Copy this file to `.env.local` and fill in real values.
# All secrets are server-side only. Never expose them to the browser.
# ===========================================================================

# ---- Core ----------------------------------------------------------------
# Set to "memory" to run with an in-memory store (no Postgres required).
# Set to "postgres" to use a real PostgreSQL database.
ARENA_DB_DRIVER=memory
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arena_os

# Secret used for session signing (use a long random string in production).
ARENA_SESSION_SECRET=dev-only-change-me
# Seed login for the single-developer workspace (used by the memory driver).
ARENA_SEED_EMAIL=dev@arena.os
ARENA_SEED_PASSWORD=arena-dev

# ---- AI providers (user-connected keys) ----------------------------------
# Leave blank to disable a provider; the gateway falls back to the mock model.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Integrations --------------------------------------------------------
# GitHub personal access token (repo + read:org scopes recommended).
GITHUB_TOKEN=
# Supabase / Railway / Firebase are scaffolded; fill when wiring real adapters.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
RAILWAY_TOKEN=
FIREBASE_PROJECT_ID=

# ---- Stellar (receipt anchoring + the "stellar" agent stage only) --------
# Payment settlement moved to BMONI (below) — this section is unrelated to
# payments now. Still used by src/stellar/receipt-anchor.ts and the general
# "stellar" pipeline stage/agent.
# "testnet" for development, "mainnet" for production.
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=
STELLAR_SECRET_KEY=
STELLAR_RECEIPT_CONTRACT_ID=

# ---- BMONI (payment settlement) -------------------------------------------
# Replaces Stellar/x402 as the payment.request tool's settlement rail
# (src/bmoni/*, src/tools/payment.ts). Sandbox: the shared dev key from
# BMONI's own docs, works only against the dev base URL below. Get a
# partner key from developers@bkey.me before production.
BMONI_API_KEY=pk_a025cacbf33a_76fb864113f3540909de5b1da39cc146906e35b1c6d4d1e4
BMONI_BASE_URL=https://embedded-dev.bmoni.com
# The operator smart wallet Arena settles payments from — provisioned once,
# out of band (see apps/oracle-web/src/app/onboard for the same lifecycle
# this wallet went through: create user -> provision wallet -> KYC ->
# activate rail). Leave blank to run in mock/offline settlement mode.
BMONI_OPERATOR_USER_ID=
BMONI_OPERATOR_SMART_WALLET_ID=
# Raw EOA private key for the operator's smart-wallet owner. Server-side
# only, signs autonomously with no human PIN step — see src/bmoni/wallet.ts
# for why that's the correct tradeoff for this specific use case.
BMONI_OPERATOR_PRIVATE_KEY=

# ---- x402 policy (currency-agnostic; field names are legacy — see
# src/bmoni/x402.ts) -----------------------------------------------------
# Facilitator endpoint used only in mock/offline settlement mode.
X402_FACILITATOR_URL=
# Default per-mission spending limit, now in NGN despite the XLM-suffixed
# name (kept for compatibility with the existing DB schema — see
# src/bmoni/x402.ts's docstring).
ARENA_DEFAULT_MISSION_XLM_LIMIT=2500
ARENA_DEFAULT_PER_REQUEST_NGN_LIMIT=500
ARENA_DEFAULT_DAILY_NGN_LIMIT=10000
ARENA_APPROVAL_THRESHOLD_NGN=250
# Demo recipient for the payment pipeline's example flow (a valid but inert
# 0x address by default — see src/mission/engine.ts).
ARENA_PAYMENT_DEMO_RECIPIENT=
